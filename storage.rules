rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidReceiptUpload() {
      return request.resource != null &&
             request.resource.size < 5 * 1024 * 1024 &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf');
    }

    // Pending receipts uploaded before an entry ID exists (new-entry flow).
    match /users/{userId}/receipts/_pending/{fileName} {
      allow read, delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
                   fileName.size() > 0 &&
                   fileName.size() <= 120 &&
                   isValidReceiptUpload();
    }

    // Final receipts stored under their entry ID.
    match /users/{userId}/receipts/{entryId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow write: if isOwner(userId) &&
                   entryId.size() > 0 &&
                   fileName.size() > 0 &&
                   fileName.size() <= 120 &&
                   isValidReceiptUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
